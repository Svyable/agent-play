{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-play.org/schemas/attack.schema.json",
  "title": "Agent Play Mechanism Attack",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "mechanism", "failure_class", "status", "demonstration", "violated_invariant", "cost_bearer", "detection", "mitigation", "disclosure", "safety"],
  "properties": {
    "protocol": {"const": "agent-play/attack/0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "mechanism": {"type": "string", "minLength": 3},
    "failure_class": {"enum": ["sybil", "reciprocal-credit", "duplicate-credit", "provenance-evasion", "evaluator-gaming", "calibration-gaming", "governance-capture", "unsafe-execution", "other"]},
    "status": {"enum": ["open", "mitigated", "accepted-risk", "invalid"]},
    "demonstration": {"type": "string", "minLength": 20},
    "violated_invariant": {"type": "string", "minLength": 15},
    "cost_bearer": {"type": "string", "minLength": 3},
    "detection": {"type": "string", "minLength": 10},
    "mitigation": {"type": "string", "minLength": 3},
    "regression_test": {"type": ["string", "null"]},
    "disclosure": {"enum": ["public", "coordinated"]},
    "safety": {"type": "string", "minLength": 10},
    "references": {"type": "array", "items": {"type": "string"}}
  }
}
